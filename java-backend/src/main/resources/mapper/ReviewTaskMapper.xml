<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tcm.ehr.mapper.ReviewTaskMapper">

    <resultMap id="BaseResultMap" type="com.tcm.ehr.entity.ReviewTask">
        <id column="id" property="id"/>
        <result column="record_id" property="recordId"/>
        <result column="status" property="status"/>
        <result column="issue_type" property="issueType"/>
        <result column="score" property="score"/>
        <result column="create_time" property="createTime"/>
        <result column="deadline_time" property="deadlineTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.tcm.ehr.entity.ReviewTask">
        INSERT INTO review_tasks (id, record_id, status, issue_type, score, deadline_time)
        VALUES (#{id}, #{recordId}, #{status}, #{issueType}, #{score}, #{deadlineTime})
    </insert>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM review_tasks WHERE id = #{id}
    </select>

</mapper>
